<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>KiranaGo – Your Neighbourhood, Delivered in Minutes</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet" />
<style>
  :root {
    --brand-green: #1a7a4a;
    --brand-green-light: #e8f5ef;
    --brand-green-mid: #2ea165;
    --brand-orange: #f97316;
    --brand-orange-light: #fff3eb;
    --brand-dark: #0f1b12;
    --brand-text: #1c2a20;
    --brand-muted: #5a7060;
    --brand-border: #d4e5da;
    --brand-surface: #f4faf6;
    --brand-white: #ffffff;
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 22px;
    --radius-xl: 32px;
    --shadow-card: 0 2px 16px rgba(26,122,74,0.08);
    --font-display: 'Syne', sans-serif;
    --font-body: 'DM Sans', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--brand-white);
    color: var(--brand-text);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ---- NAVBAR ---- */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--brand-border);
    height: 64px;
    display: flex;
    align-items: center;
  }

  .nav-inner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    color: var(--brand-green);
    text-decoration: none;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  .logo span { color: var(--brand-orange); }

  .nav-location {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
    border-radius: 40px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-text);
    cursor: pointer;
    transition: background 0.2s;
  }

  .nav-location:hover { background: var(--brand-green-light); }

  .nav-location .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--brand-orange);
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0%,100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.7; }
  }

  .nav-search {
    flex: 1;
    max-width: 480px;
    position: relative;
  }

  .nav-search input {
    width: 100%;
    height: 40px;
    background: var(--brand-surface);
    border: 1.5px solid var(--brand-border);
    border-radius: 40px;
    padding: 0 16px 0 40px;
    font-size: 14px;
    font-family: var(--font-body);
    color: var(--brand-text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .nav-search input:focus {
    border-color: var(--brand-green);
    box-shadow: 0 0 0 3px rgba(26,122,74,0.12);
  }

  .nav-search input::placeholder { color: var(--brand-muted); }

  .nav-search-icon {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--brand-muted);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .btn-ghost {
    background: none;
    border: 1.5px solid var(--brand-border);
    border-radius: 40px;
    padding: 7px 18px;
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-body);
    color: var(--brand-text);
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-ghost:hover {
    border-color: var(--brand-green);
    color: var(--brand-green);
  }

  .btn-primary {
    background: var(--brand-green);
    border: none;
    border-radius: 40px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-body);
    color: white;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
  }

  .btn-primary:hover { background: var(--brand-green-mid); }
  .btn-primary:active { transform: scale(0.97); }

  .cart-btn {
    position: relative;
    background: var(--brand-green);
    border: none;
    border-radius: 40px;
    padding: 8px 18px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-body);
    color: white;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cart-btn:hover { background: var(--brand-dark); }

  .cart-count {
    background: var(--brand-orange);
    color: white;
    font-size: 11px;
    font-weight: 700;
    width: 20px; height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ---- HERO ---- */
  .hero {
    padding-top: 64px;
    min-height: 100vh;
    background: linear-gradient(135deg, #f4faf6 0%, #e8f5ef 40%, #fff8f0 100%);
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -120px; right: -120px;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(46,161,101,0.12) 0%, transparent 70%);
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -80px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%);
  }

  .hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-white);
    border: 1px solid var(--brand-border);
    border-radius: 40px;
    padding: 6px 14px 6px 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-green);
    margin-bottom: 24px;
  }

  .hero-tag-dot {
    width: 24px; height: 24px;
    background: var(--brand-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -2px;
    color: var(--brand-dark);
    margin-bottom: 20px;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--brand-green);
    position: relative;
  }

  .hero h1 em::after {
    content: '';
    position: absolute;
    bottom: 2px; left: 0; right: 0;
    height: 4px;
    background: var(--brand-orange);
    border-radius: 2px;
    opacity: 0.6;
  }

  .hero-sub {
    font-size: 18px;
    color: var(--brand-muted);
    font-weight: 300;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 420px;
  }

  .hero-search {
    display: flex;
    gap: 0;
    background: var(--brand-white);
    border: 2px solid var(--brand-green);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(26,122,74,0.15);
    margin-bottom: 32px;
  }

  .hero-search input {
    flex: 1;
    border: none;
    outline: none;
    padding: 16px 20px;
    font-size: 15px;
    font-family: var(--font-body);
    color: var(--brand-text);
    background: transparent;
  }

  .hero-search input::placeholder { color: var(--brand-muted); }

  .hero-search button {
    background: var(--brand-green);
    border: none;
    padding: 12px 28px;
    margin: 6px;
    border-radius: 22px;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-body);
    color: white;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .hero-search button:hover { background: var(--brand-dark); }

  .hero-stats {
    display: flex;
    gap: 32px;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
  }

  .hero-stat-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    color: var(--brand-dark);
    letter-spacing: -1px;
  }

  .hero-stat-label {
    font-size: 12px;
    color: var(--brand-muted);
    font-weight: 400;
  }

  /* Hero visual */
  .hero-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .app-mockup {
    background: var(--brand-white);
    border-radius: 24px;
    border: 1.5px solid var(--brand-border);
    box-shadow: 0 20px 60px rgba(15,27,18,0.12);
    overflow: hidden;
    max-width: 340px;
    margin: 0 auto;
  }

  .mockup-header {
    background: var(--brand-green);
    padding: 20px;
    color: white;
  }

  .mockup-header h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .mockup-header p { font-size: 12px; opacity: 0.8; }

  .mockup-timer {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.15);
    border-radius: 40px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 700;
    margin-top: 12px;
    width: fit-content;
  }

  .timer-ring {
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: white;
    animation: spin 1s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .mockup-body { padding: 16px; }

  .store-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--brand-surface);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-md);
    padding: 12px;
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .store-card:hover { border-color: var(--brand-green); }

  .store-icon {
    width: 44px; height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }

  .store-info h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-dark);
    margin-bottom: 2px;
  }

  .store-info p {
    font-size: 11px;
    color: var(--brand-muted);
  }

  .store-badge {
    margin-left: auto;
    background: var(--brand-green-light);
    color: var(--brand-green);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 40px;
    flex-shrink: 0;
  }

  /* Floating cards */
  .float-card {
    position: absolute;
    background: var(--brand-white);
    border: 1.5px solid var(--brand-border);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    box-shadow: var(--shadow-card);
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    animation: float 4s ease-in-out infinite;
  }

  .float-card.fc-1 { top: -20px; right: -20px; animation-delay: 0s; }
  .float-card.fc-2 { bottom: 40px; left: -40px; animation-delay: 1.5s; }

  @keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* ---- SECTIONS ---- */
  section { position: relative; }

  .section-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--brand-green);
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--brand-dark);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .section-sub {
    font-size: 17px;
    color: var(--brand-muted);
    font-weight: 300;
    max-width: 540px;
    line-height: 1.65;
  }

  /* ---- DELIVERY PROMISE BAR ---- */
  .promise-bar {
    background: var(--brand-dark);
    padding: 20px 0;
    overflow: hidden;
  }

  .promise-track {
    display: flex;
    gap: 60px;
    animation: marquee 20s linear infinite;
    white-space: nowrap;
    width: max-content;
  }

  .promise-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: white;
  }

  .promise-item .pi-icon {
    width: 28px; height: 28px;
    background: var(--brand-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---- CATEGORIES ---- */
  .categories-section { background: var(--brand-white); }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
    margin-top: 40px;
  }

  .cat-card {
    background: var(--brand-surface);
    border: 1.5px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 24px 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25s;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .cat-card:hover {
    border-color: var(--brand-green);
    background: var(--brand-green-light);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(26,122,74,0.12);
  }

  .cat-icon {
    width: 56px; height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
  }

  .cat-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-text);
    line-height: 1.3;
  }

  .cat-count {
    font-size: 11px;
    color: var(--brand-muted);
  }

  /* ---- PRODUCTS GRID ---- */
  .products-section { background: var(--brand-surface); }

  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .filter-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill {
    background: var(--brand-white);
    border: 1.5px solid var(--brand-border);
    border-radius: 40px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--brand-text);
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-body);
  }

  .pill:hover, .pill.active {
    background: var(--brand-green);
    border-color: var(--brand-green);
    color: white;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  .product-card {
    background: var(--brand-white);
    border: 1.5px solid var(--brand-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.25s;
    cursor: pointer;
  }

  .product-card:hover {
    box-shadow: 0 8px 32px rgba(26,122,74,0.14);
    transform: translateY(-4px);
    border-color: var(--brand-green);
  }

  .product-img {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 60px;
    position: relative;
    overflow: hidden;
  }

  .product-badge {
    position: absolute;
    top: 10px; left: 10px;
    background: var(--brand-orange);
    color: white;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 40px;
  }

  .product-time {
    position: absolute;
    top: 10px; right: 10px;
    background: var(--brand-dark);
    color: white;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 40px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .product-info { padding: 14px; }

  .product-store {
    font-size: 11px;
    color: var(--brand-muted);
    font-weight: 500;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .product-store::before {
    content: '';
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--brand-green);
    flex-shrink: 0;
  }

  .product-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--brand-dark);
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .product-weight {
    font-size: 12px;
    color: var(--brand-muted);
    margin-bottom: 10px;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .product-price {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    color: var(--brand-dark);
  }

  .product-price-old {
    font-size: 12px;
    color: var(--brand-muted);
    text-decoration: line-through;
    margin-left: 4px;
  }

  .add-btn {
    background: var(--brand-green);
    border: none;
    border-radius: var(--radius-md);
    width: 36px; height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    color: white;
    font-size: 20px;
    font-weight: 300;
  }

  .add-btn:hover { background: var(--brand-dark); transform: scale(1.05); }

  /* ---- HOW IT WORKS ---- */
  .how-section { background: var(--brand-dark); overflow: hidden; }

  .how-section .section-title { color: white; }
  .how-section .section-sub { color: rgba(255,255,255,0.5); }
  .how-section .section-label { color: var(--brand-green-mid); }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  .how-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    position: relative;
    transition: all 0.3s;
  }

  .how-card:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(46,161,101,0.4);
    transform: translateY(-4px);
  }

  .how-num {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 800;
    color: rgba(255,255,255,0.06);
    position: absolute;
    top: 16px; right: 20px;
    line-height: 1;
  }

  .how-icon-wrap {
    width: 56px; height: 56px;
    background: var(--brand-green);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 20px;
  }

  .how-card h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: white;
    margin-bottom: 10px;
    letter-spacing: -0.5px;
  }

  .how-card p {
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    line-height: 1.65;
  }

  .how-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.15);
    font-size: 24px;
  }

  /* ---- PROXIMITY FEATURE ---- */
  .proximity-section { background: var(--brand-white); }

  .proximity-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    margin-top: 48px;
  }

  .proximity-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .prox-card {
    border: 2px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: all 0.25s;
    cursor: default;
    position: relative;
    overflow: hidden;
  }

  .prox-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
  }

  .prox-card.prox-walk { border-color: #fcd34d; }
  .prox-card.prox-walk::before { background: #f59e0b; }

  .prox-card.prox-nearby { border-color: #86efac; }
