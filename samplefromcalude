    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
  }

  .app-content h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--brand-dark);
    line-height: 1.1;
    margin-bottom: 16px;
  }

  .app-content p {
    font-size: 17px;
    color: var(--brand-muted);
