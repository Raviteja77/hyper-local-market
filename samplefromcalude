      <label>Area or pincode</label>
      <input type="text" placeholder="560047 or Koramangala" id="manual-location" />
    </div>
    <button class="btn-submit" onclick="setManualLocation()">Find stores →</button>
  </div>
</div>

<script>
  // ---- Products data ----
  const products = [
    { id:1, name:'Amul Full Cream Milk', weight:'500ml', price:28, oldPrice:30, emoji:'🥛', bg:'#e8f5ef', store:'Raju Store', time:'6 min', badge:'FRESH' },
    { id:2, name:'Britannia Bread', weight:'400g', price:42, oldPrice:45, emoji:'🍞', bg:'#fff8ed', store:'Raju Store', time:'6 min', badge:'10% OFF' },
    { id:3, name:'Farm Eggs', weight:'6 pcs', price:55, oldPrice:null, emoji:'🥚', bg:'#fffbeb', store:'Sharma Kirana', time:'11 min', badge:null },
    { id:4, name:'Haldiram Bhujia', weight:'200g', price:75, oldPrice:82, emoji:'🍿', bg:'#fff3eb', store:'Sharma Kirana', time:'11 min', badge:'8% OFF' },
    { id:5, name:'Surf Excel Easy Wash', weight:'1kg', price:180, oldPrice:200, emoji:'🧺', bg:'#eff6ff', store:'Anand Mart', time:'15 min', badge:'10% OFF' },
    { id:6, name:'Dettol Liquid Soap', weight:'250ml', price:85, oldPrice:null, emoji:'🧴', bg:'#f0fdf4', store:'Anand Mart', time:'15 min', badge:null },
    { id:7, name:'Tata Salt', weight:'1kg', price:22, oldPrice:24, emoji:'🧂', bg:'#f9fafb', store:'Raju Store', time:'6 min', badge:null },
    { id:8, name:'Nescafe Classic', weight:'50g', price:120, oldPrice:132, emoji:'☕', bg:'#fff8f0', store:'Sharma Kirana', time:'11 min', badge:'9% OFF' },
    { id:9, name:'Tomatoes', weight:'500g', price:32, oldPrice:null, emoji:'🍅', bg:'#fff1f2', store:'Gupta Store', time:'14 min', badge:'FRESH' },
    { id:10, name:'Maggi Noodles', weight:'420g (6pk)', price:88, oldPrice:96, emoji:'🍜', bg:'#fffbeb', store:'Raju Store', time:'6 min', badge:'POPULAR' },
    { id:11, name:'Colgate Toothpaste', weight:'200g', price:98, oldPrice:110, emoji:'🦷', bg:'#eff6ff', store:'Anand Mart', time:'15 min', badge:'10% OFF' },
    { id:12, name:'Parle-G Biscuits', weight:'800g', price:62, oldPrice:null, emoji:'🍪', bg:'#fffbeb', store:'Sharma Kirana', time:'11 min', badge:'CLASSIC' },
  ];

  let cart = {};

  function renderProducts() {
    const grid = document.getElementById('products-grid');
    grid.innerHTML = products.map(p => `
      <div class="product-card" id="pcard-${p.id}">
        <div class="product-img" style="background:${p.bg};">
          <span style="font-size:64px;">${p.emoji}</span>
          ${p.badge ? `<div class="product-badge">${p.badge}</div>` : ''}
          <div class="product-time">⚡ ${p.time}</div>
        </div>
        <div class="product-info">
          <div class="product-store">${p.store}</div>
          <div class="product-name">${p.name}</div>
          <div class="product-weight">${p.weight}</div>
          <div class="product-footer">
            <div>
              <span class="product-price">₹${p.price}</span>
              ${p.oldPrice ? `<span class="product-price-old">₹${p.oldPrice}</span>` : ''}
            </div>
            <button class="add-btn" onclick="addToCart(${p.id})" id="abtn-${p.id}">+</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  function addToCart(id) {
    const p = products.find(x => x.id === id);
    if (!cart[id]) { cart[id] = { ...p, qty: 0 }; }
    cart[id].qty += 1;
    updateCart();
    showToast(`🛒 ${p.emoji} ${p.name} added to cart`);
  }

  function updateCart() {
    const items = Object.values(cart).filter(x => x.qty > 0);
    const total = items.reduce((s, x) => s + x.price * x.qty, 0);
    const count = items.reduce((s, x) => s + x.qty, 0);

    document.getElementById('cart-count').textContent = count;

    const cartItemsEl = document.getElementById('cart-items');
    const cartFooter = document.getElementById('cart-footer');

    if (items.length === 0) {
      cartItemsEl.innerHTML = `<div style="text-align:center;padding:48px 24px;color:var(--brand-muted);">
        <div style="font-size:48px;margin-bottom:12px;">🛒</div>
        <div style="font-size:15px;font-weight:500;">Your cart is empty</div>
        <div style="font-size:13px;margin-top:8px;">Add items from the store!</div>
      </div>`;
      cartFooter.style.display = 'none';
      return;
    }

    cartFooter.style.display = 'block';
    document.getElementById('cart-total').textContent = `₹${total}`;

    cartItemsEl.innerHTML = items.map(item => `
      <div class="cart-item">
        <div class="cart-item-emoji">${item.emoji}</div>
        <div class="cart-item-info">
          <div class="cart-item-name">${item.name}</div>
          <div class="cart-item-price">₹${item.price} × ${item.qty} = ₹${item.price * item.qty}</div>
        </div>
        <div class="cart-qty">
          <button onclick="changeQty(${item.id}, -1)">−</button>
          <span>${item.qty}</span>
          <button onclick="changeQty(${item.id}, 1)">+</button>
        </div>
      </div>
    `).join('');
  }

  function changeQty(id, delta) {
    if (!cart[id]) return;
    cart[id].qty = Math.max(0, cart[id].qty + delta);
    if (cart[id].qty === 0) delete cart[id];
    updateCart();
  }

  function toggleCart() {
    const sidebar = document.getElementById('cart-sidebar');
    const overlay = document.getElementById('cart-overlay');
    sidebar.classList.toggle('open');
    overlay.classList.toggle('open');
    document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
  }

  // ---- Modals ----
  function openModal(id) { document.getElementById(id).classList.add('open'); }
  function closeModal(id) { document.getElementById(id).classList.remove('open'); }
  function closeModalOnBg(e, id) { if (e.target.id === id) closeModal(id); }
  function openLocationModal() { openModal('location-modal'); }

  // ---- Location ----
  function detectLocation() {
    showToast('📍 Detecting your location...');
    setTimeout(() => {
      document.getElementById('location-text').textContent = 'Koramangala, Bangalore';
      closeModal('location-modal');
      showToast('✓ Location set to Koramangala, Bangalore');
    }, 1500);
  }

  function setManualLocation() {
    const val = document.getElementById('manual-location').value.trim();
    if (val) {
      document.getElementById('location-text').textContent = val;
      closeModal('location-modal');
      showToast('✓ Location updated to ' + val);
    }
  }

  function setLocation() {
    const val = document.getElementById('hero-location-input').value.trim();
    if (val) {
      document.getElementById('location-text').textContent = val;
      showToast('✓ Showing stores near ' + val);
    } else {
      openLocationModal();
    }
  }

  // ---- Toast ----
  function showToast(msg) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-text').textContent = msg;
    toast.classList.add('show');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('show'), 3000);
  }

  // ---- Filter pills ----
  function setPill(el, type) {
    document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    if (type === 'walkpick') showToast('🚶 Showing Walk & Pick eligible items');
    if (type === 'fastest') showToast('⚡ Sorted by fastest delivery');
    if (type === 'cheapest') showToast('💰 Sorted by best price');
  }

  function filterProducts(cat) {
    showToast('🔍 Showing ' + cat + ' items');
    window.scrollTo({ top: document.querySelector('.products-section').offsetTop - 80, behavior: 'smooth' });
  }

  // ---- Scroll animations ----
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

  // ---- Init ----
  renderProducts();

  // Nav scroll effect
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    nav.style.boxShadow = window.scrollY > 10 ? '0 2px 20px rgba(15,27,18,0.08)' : 'none';
  });
</script>
