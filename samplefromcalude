  .phone-screen-body { padding: 10px; flex: 1; }

  .phone-product {
    background: white;
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 8px;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .phone-product-emoji { font-size: 20px; }

  .phone-product-info .ppn { font-size: 10px; font-weight: 600; color: var(--brand-dark); }
  .phone-product-info .ppp { font-size: 10px; color: var(--brand-green); font-weight: 700; }

  /* ---- FOOTER ---- */
  footer {
    background: var(--brand-dark);
