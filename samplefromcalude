    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 20px;
    color: var(--brand-muted);
    transition: all 0.2s;
  }

  .cart-close:hover { background: var(--brand-border); }

  .cart-items {
    flex: 1;
    overflow-y: auto;
    padding: 16px 24px;
  }

  .cart-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--brand-border);
  }

  .cart-item-emoji {
    font-size: 32px;
    width: 52px; height: 52px;
    background: var(--brand-surface);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cart-item-info { flex: 1; }
  .cart-item-name { font-size: 14px; font-weight: 600; color: var(--brand-dark); margin-bottom: 2px; }
  .cart-item-price { font-size: 13px; color: var(--brand-green); font-weight: 600; }

  .cart-qty {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--brand-surface);
    border-radius: 40px;
    padding: 4px 8px;
  }

  .cart-qty button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    color: var(--brand-green);
    font-weight: 600;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-qty span { font-size: 14px; font-weight: 600; min-width: 16px; text-align: center; }

  .cart-footer {
    padding: 24px;
    border-top: 1px solid var(--brand-border);
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .cart-total span { font-size: 15px; color: var(--brand-muted); }

  .cart-total strong {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    color: var(--brand-dark);
  }

  .cart-delivery-note {
    background: var(--brand-green-light);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 13px;
    color: var(--brand-green);
    font-weight: 500;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .btn-checkout {
    width: 100%;
    background: var(--brand-green);
    border: none;
    border-radius: var(--radius-md);
    padding: 16px;
    font-size: 16px;
    font-weight: 700;
    font-family: var(--font-display);
    color: white;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: -0.3px;
  }

  .btn-checkout:hover { background: var(--brand-dark); }

  .cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15,27,18,0.4);
    z-index: 2999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .cart-overlay.open { opacity: 1; pointer-events: all; }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero-visual { display: none; }
    .partner-inner { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .proximity-grid { grid-template-columns: 1fr; }
    .app-inner { grid-template-columns: 1fr; }
    .app-phones { display: none; }
  }

  @media (max-width: 600px) {
    .nav-search { display: none; }
    .footer-grid { grid-template-columns: 1fr; }
    .cat-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
    .products-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
    .cart-sidebar { width: 100%; }
    .hero-stats { flex-wrap: wrap; gap: 20px; }
  }

  /* Scroll animations */
  .fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .fade-in.visible { opacity: 1; transform: translateY(0); }

  /* Loading state */
  .skeleton {
    background: linear-gradient(90deg, #f0f4f1 25%, #e0ebe3 50%, #f0f4f1 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius-md);
  }

  @keyframes shimmer {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
  }
</style>
